{
  "name": "t-video-media-demo",
  "main": "src/worker.js",
  "compatibility_date": "2025-05-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tvmd-db",
      "database_id": "local"
    }
  ]
}
